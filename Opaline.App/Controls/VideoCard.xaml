<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Opaline.App.Controls.VideoCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="VideoCard">

    <Border x:Name="RootBorder"
            Style="{StaticResource VideoCardStyle}"
            PointerEntered="Root_PointerEntered"
            PointerExited="Root_PointerExited">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="168"
                  Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <Image x:Name="ThumbImage" Stretch="UniformToFill"
                       AutomationProperties.Name="Thumbnail" />
                <Border x:Name="DurationBadge"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,8,8" Padding="6,2"
                        Background="#CC000000"
                        CornerRadius="4">
                    <TextBlock x:Name="DurationText"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="SemiBold" />
                </Border>
                <Button x:Name="MenuButton"
                        Content="&#xE712;"
                        FontFamily="Segoe MDL2 Assets"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,6,6,0" Padding="8,4"
                        MinWidth="32" MinHeight="28"
                        Background="#99000000" Foreground="White"
                        BorderThickness="0"
                        CornerRadius="4"
                        Click="MenuButton_Click"
                        AutomationProperties.Name="视频菜单"
                        AutomationProperties.AutomationId="VideoCardMenu" />
            </Grid>

            <StackPanel Grid.Row="1" Padding="12,10,12,12" Spacing="2">
                <TextBlock x:Name="TitleText"
                           TextWrapping="WrapWholeWords"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="ChannelText"
                           Opacity="0.7"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock x:Name="ViewsText"
                           Opacity="0.55"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
