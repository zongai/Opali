<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Opaline.App.Controls.VideoCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="VideoCard">

    <Border x:Name="RootBorder"
            Style="{StaticResource VideoCardStyle}"
            PointerEntered="Root_PointerEntered"
            PointerExited="Root_PointerExited">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="180"
                  Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <Image x:Name="ThumbImage" Stretch="UniformToFill"
                       AutomationProperties.Name="Thumbnail" />
                <Border x:Name="DurationBadge"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,8,8" Padding="6,2"
                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                    <TextBlock x:Name="DurationText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Padding="12,10,12,12" Spacing="4">
                <TextBlock x:Name="TitleText"
                           TextWrapping="WrapWholeWords"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="ChannelText"
                           Opacity="0.7"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock x:Name="ViewsText"
                           Opacity="0.55"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
