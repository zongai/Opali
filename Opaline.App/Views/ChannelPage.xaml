<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Opaline.App.Views.ChannelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Opaline.Core.Models"
    xmlns:controls="using:Opaline.App.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar Grid.Row="0"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 Severity="Error"
                 IsClosable="True" />

        <Grid Grid.Row="1" Padding="24,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="72" Height="72" CornerRadius="36" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Image Source="{x:Bind ViewModel.AvatarUrl, Mode=OneWay}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleLargeTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.SubscriberText, Mode=OneWay}" Opacity="0.7" />
            </StackPanel>
            <Button Grid.Column="2"
                    Content="Subscribe"
                    Command="{x:Bind ViewModel.ToggleSubscribeCommand}"
                    AutomationProperties.AutomationId="ChannelSubscribeButton" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Padding="24,0,24,8">
            <Button Content="Videos" Click="Tab_Click" Tag="0" AutomationProperties.AutomationId="ChannelTabVideos" />
            <Button Content="Shorts" Click="Tab_Click" Tag="1" AutomationProperties.AutomationId="ChannelTabShorts" />
            <Button Content="Live" Click="Tab_Click" Tag="2" AutomationProperties.AutomationId="ChannelTabLive" />
            <Button Content="Playlists" Click="Tab_Click" Tag="3" AutomationProperties.AutomationId="ChannelTabPlaylists" />
        </StackPanel>

        <GridView Grid.Row="3"
                  Padding="24,0,24,24"
                  ItemsSource="{x:Bind ViewModel.Videos, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="Grid_ItemClick"
                  AutomationProperties.AutomationId="ChannelVideosGrid">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:Video">
                    <controls:VideoCard Video="{x:Bind}" Width="280" Margin="0,0,12,12" />
                </DataTemplate>
            </GridView.ItemTemplate>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>

        <ProgressRing Grid.Row="3" Width="48" Height="48"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
