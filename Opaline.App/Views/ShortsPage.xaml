<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Opaline.App.Views.ShortsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Opaline.Core.Models">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Shorts" Style="{StaticResource TitleLargeTextBlockStyle}" />
        <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Shorts, Mode=OneWay}"
                  IsItemClickEnabled="True"
                  ItemClick="Shorts_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Video">
                    <StackPanel Spacing="4" Padding="8">
                        <TextBlock Text="{x:Bind Title}" TextWrapping="WrapWholeWords" MaxLines="2"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ChannelTitle}" Opacity="0.7" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
