<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Opaline.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="8" MaxWidth="720">
            <TextBlock Text="Settings" Style="{StaticResource TitleLargeTextBlockStyle}" Margin="0,0,0,16" />

            <!-- Account -->
            <TextBlock Text="Account" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,4" />
            <controls:SettingsCard Header="YouTube sign-in"
                                   Description="Device-code OAuth for subscriptions and account features">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Sign in" Click="SignIn_Click"
                            Visibility="{x:Bind Auth.IsSignedIn, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <Button Content="Sign out" Click="SignOut_Click"
                            Visibility="{x:Bind Auth.IsSignedIn, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </controls:SettingsCard>
            <InfoBar IsOpen="{x:Bind Auth.StatusMessage, Mode=OneWay, Converter={StaticResource NullToBoolConverter}}"
                     Message="{x:Bind Auth.StatusMessage, Mode=OneWay}"
                     Severity="Informational" IsClosable="True" />
            <TextBlock Text="{x:Bind Auth.UserCode, Mode=OneWay}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       HorizontalAlignment="Center"
                       Visibility="{x:Bind Auth.IsWaiting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Appearance -->
            <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,4" />
            <controls:SettingsCard Header="Theme" Description="Light, dark or follow system">
                <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}" MinWidth="160">
                    <ComboBoxItem Content="System" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                </ComboBox>
            </controls:SettingsCard>

            <!-- Playback helpers -->
            <TextBlock Text="Playback" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,4" />
            <controls:SettingsCard Header="SponsorBlock" Description="Skip sponsored segments">
                <ToggleSwitch IsOn="{x:Bind ViewModel.SponsorBlockEnabled, Mode=TwoWay}" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Return YouTube Dislike" Description="Show community dislike counts">
                <ToggleSwitch IsOn="{x:Bind ViewModel.RydEnabled, Mode=TwoWay}" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Solver server" Description="n-parameter + PO token endpoint">
                <TextBox Text="{x:Bind ViewModel.SolverBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MinWidth="280" />
            </controls:SettingsCard>

            <controls:SettingsCard Header="About" Description="Opaline for Windows — lightweight YouTube client">
                <TextBlock Text="v0.2.0" Opacity="0.6" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
