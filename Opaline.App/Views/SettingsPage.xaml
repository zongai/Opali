<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Opaline.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="12" MaxWidth="720">
            <TextBlock Text="Settings" Style="{StaticResource TitleLargeTextBlockStyle}" Margin="0,0,0,8" />

            <TextBlock Text="Account" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Sign in" Click="SignIn_Click" />
                <Button Content="Sign out" Click="SignOut_Click" />
            </StackPanel>
            <TextBlock Text="{x:Bind Auth.StatusMessage, Mode=OneWay}" TextWrapping="WrapWholeWords" Opacity="0.8" />
            <TextBlock Text="{x:Bind Auth.UserCode, Mode=OneWay}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       HorizontalAlignment="Center" />

            <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Theme" VerticalAlignment="Center" />
                <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}" MinWidth="160">
                    <ComboBoxItem Content="System" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                </ComboBox>
            </StackPanel>

            <TextBlock Text="Playback" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <ToggleSwitch Header="SponsorBlock" IsOn="{x:Bind ViewModel.SponsorBlockEnabled, Mode=TwoWay}" />
            <ToggleSwitch Header="Return YouTube Dislike" IsOn="{x:Bind ViewModel.RydEnabled, Mode=TwoWay}" />
            <TextBox Header="Solver server"
                     Text="{x:Bind ViewModel.SolverBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Opaline for Windows v0.3.0" Opacity="0.5" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
