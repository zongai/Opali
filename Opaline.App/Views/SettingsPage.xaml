<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Opaline.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="12" MaxWidth="720">
            <TextBlock Text="Settings" Style="{StaticResource TitleLargeTextBlockStyle}" Margin="0,0,0,8" />

            <TextBlock Text="Account" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Sign in" Click="SignIn_Click"
                        AutomationProperties.AutomationId="SettingsSignIn" />
                <Button Content="Sign out" Click="SignOut_Click"
                        AutomationProperties.AutomationId="SettingsSignOut" />
            </StackPanel>
            <TextBlock Text="{x:Bind Auth.StatusMessage, Mode=OneWay}" TextWrapping="WrapWholeWords" Opacity="0.8" />
            <TextBlock Text="{x:Bind Auth.UserCode, Mode=OneWay}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       HorizontalAlignment="Center" />

            <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Theme" VerticalAlignment="Center" />
                <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                          MinWidth="160"
                          AutomationProperties.AutomationId="SettingsTheme"
                          AutomationProperties.Name="Theme">
                    <ComboBoxItem Content="System" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                </ComboBox>
            </StackPanel>

            <TextBlock Text="Playback" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <ToggleSwitch Header="SponsorBlock"
                          IsOn="{x:Bind ViewModel.SponsorBlockEnabled, Mode=TwoWay}"
                          AutomationProperties.AutomationId="SettingsSponsorBlock" />
            <ToggleSwitch Header="Return YouTube Dislike"
                          IsOn="{x:Bind ViewModel.RydEnabled, Mode=TwoWay}"
                          AutomationProperties.AutomationId="SettingsRyd" />
            <TextBox Header="Solver server"
                     Text="{x:Bind ViewModel.SolverBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="SettingsSolverUrl" />
            <TextBlock Text="{x:Bind ViewModel.BotGuardStatus, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.75"
                       AutomationProperties.AutomationId="SettingsBotGuardStatus" />
            <ToggleSwitch Header="Prefer AV1 (when available)"
                          IsOn="{x:Bind ViewModel.PreferAv1, Mode=TwoWay}"
                          AutomationProperties.AutomationId="SettingsPreferAv1" />
            <ToggleSwitch Header="Auto-dub (prefer language audio)"
                          IsOn="{x:Bind ViewModel.AutoDubEnabled, Mode=TwoWay}"
                          AutomationProperties.AutomationId="SettingsAutoDub" />
            <ToggleSwitch Header="Ignore AI auto-dubs"
                          IsOn="{x:Bind ViewModel.IgnoreAiDubs, Mode=TwoWay}"
                          AutomationProperties.AutomationId="SettingsIgnoreAiDubs" />
            <TextBox Header="Auto-dub language (e.g. zh, en, ja — empty = system)"
                     Text="{x:Bind ViewModel.AutoDubLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="SettingsAutoDubLang" />

            <TextBlock Text="Opaline for Windows v0.3.1" Opacity="0.5" Margin="0,16,0,0" />
            <TextBlock Text="Crash log: crash.log (next to Opaline.App.exe) · Session: %LOCALAPPDATA%\Opaline\oauth.json" Opacity="0.45"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
