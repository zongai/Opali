<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Opaline.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="28,20,28,32" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8" MaxWidth="760">
            <TextBlock Text="设置" Style="{StaticResource TitleLargeTextBlockStyle}" Margin="0,0,0,12" />

            <!-- Account -->
            <Expander HorizontalContentAlignment="Stretch" IsExpanded="True"
                      HorizontalAlignment="Stretch">
                <Expander.Header>
                    <TextBlock Text="账户" Style="{StaticResource SubtitleTextBlockStyle}" />
                </Expander.Header>
                <StackPanel Spacing="10" Padding="4,8,4,4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="登录" Click="SignIn_Click" Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.AutomationId="SettingsSignIn" />
                        <Button Content="退出" Click="SignOut_Click"
                                AutomationProperties.AutomationId="SettingsSignOut" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Auth.StatusMessage, Mode=OneWay}" TextWrapping="WrapWholeWords" Opacity="0.85" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="16" HorizontalAlignment="Center"
                            Visibility="{x:Bind Auth.HasUserCode, Mode=OneWay}">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="设备代码" Opacity="0.7" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind Auth.UserCode, Mode=OneWay}"
                                       Style="{StaticResource TitleTextBlockStyle}"
                                       HorizontalAlignment="Center"
                                       IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>

            <!-- Appearance -->
            <Expander HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                <Expander.Header>
                    <TextBlock Text="外观" Style="{StaticResource SubtitleTextBlockStyle}" />
                </Expander.Header>
                <StackPanel Spacing="8" Padding="4,8,4,4">
                    <ComboBox Header="主题"
                              SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                              MinWidth="200"
                              AutomationProperties.AutomationId="SettingsTheme">
                        <ComboBoxItem Content="跟随系统" />
                        <ComboBoxItem Content="浅色" />
                        <ComboBoxItem Content="深色" />
                    </ComboBox>
                </StackPanel>
            </Expander>

            <!-- Playback -->
            <Expander HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <TextBlock Text="播放" Style="{StaticResource SubtitleTextBlockStyle}" />
                </Expander.Header>
                <StackPanel Spacing="8" Padding="4,8,4,4">
                    <ToggleSwitch Header="SponsorBlock"
                                  IsOn="{x:Bind ViewModel.SponsorBlockEnabled, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="SettingsSponsorBlock" />
                    <ToggleSwitch Header="Return YouTube Dislike"
                                  IsOn="{x:Bind ViewModel.RydEnabled, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="SettingsRyd" />
                    <ToggleSwitch Header="优先 AV1（硬件支持时）"
                                  IsOn="{x:Bind ViewModel.PreferAv1, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="SettingsPreferAv1" />
                    <TextBlock Text="{x:Bind ViewModel.Av1ProbeDetail, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75"
                               TextWrapping="WrapWholeWords"
                               AutomationProperties.AutomationId="SettingsAv1Probe" />
                    <ToggleSwitch Header="自动配音（匹配语言音轨）"
                                  IsOn="{x:Bind ViewModel.AutoDubEnabled, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="SettingsAutoDub" />
                    <ToggleSwitch Header="忽略 AI 自动配音"
                                  IsOn="{x:Bind ViewModel.IgnoreAiDubs, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="SettingsIgnoreAiDubs" />
                    <TextBox Header="配音语言（如 zh / en / ja，空=系统）"
                             Text="{x:Bind ViewModel.AutoDubLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="SettingsAutoDubLang" />
                </StackPanel>
            </Expander>

            <!-- Keys / Services -->
            <Expander HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <TextBlock Text="密钥与服务" Style="{StaticResource SubtitleTextBlockStyle}" />
                </Expander.Header>
                <StackPanel Spacing="10" Padding="4,8,4,4">
                    <TextBox Header="Solver 服务器（签名 / n / pot）"
                             Text="{x:Bind ViewModel.SolverBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="https://…"
                             AutomationProperties.AutomationId="SettingsSolverUrl" />
                    <TextBlock Text="DeepL API Key（可选；未填则用 Google→MyMemory→Lingva）"
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8" />
                    <TextBox x:Name="DeepLBox"
                             Header="DeepL API Key（每行一个，支持多个）"
                             Text="{x:Bind ViewModel.DeepLApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="留空则使用免费引擎链 Google→MyMemory→Lingva"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="64"
                             AutomationProperties.AutomationId="SettingsDeepLKey" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.DeepLKeyMasked, Mode=OneWay}"
                                   VerticalAlignment="Center" Opacity="0.75"
                                   IsTextSelectionEnabled="True" />
                        <Button Content="清除 Key" Command="{x:Bind ViewModel.ClearDeepLKeyCommand}"
                                Padding="12,4" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.SecretsHint, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"
                               TextWrapping="WrapWholeWords" />
                    <TextBlock Text="{x:Bind ViewModel.BotGuardStatus, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75"
                               TextWrapping="WrapWholeWords"
                               AutomationProperties.AutomationId="SettingsBotGuardStatus" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
