<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Opaline.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Opaline.Core.Models"
    xmlns:svc="using:Opaline.Core.Services"
    xmlns:controls="using:Opaline.App.Controls">

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Library" Style="{StaticResource TitleLargeTextBlockStyle}"
                   AutomationProperties.AutomationId="LibraryTitle" />

        <Pivot Grid.Row="1" Grid.RowSpan="2" AutomationProperties.AutomationId="LibraryPivot">
            <PivotItem Header="History">
                <GridView ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="Video_ItemClick">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:Video">
                            <controls:VideoCard Video="{x:Bind}" Width="260" Margin="0,0,12,12" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
            </PivotItem>
            <PivotItem Header="Watch Later">
                <GridView ItemsSource="{x:Bind ViewModel.WatchLater, Mode=OneWay}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="Video_ItemClick">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:Video">
                            <controls:VideoCard Video="{x:Bind}" Width="260" Margin="0,0,12,12" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
            </PivotItem>
            <PivotItem Header="Playlists">
                <ListView ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="Playlist_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Playlist">
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="8">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Opacity="0.6" VerticalAlignment="Center">
                                    <Run Text="{x:Bind VideoCount}" /><Run Text=" videos" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
            <PivotItem Header="Downloads">
                <ListView ItemsSource="{x:Bind ViewModel.Downloads, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="svc:DownloadedItem">
                            <StackPanel Padding="8" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind FilePath}" Opacity="0.6" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
