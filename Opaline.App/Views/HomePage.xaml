<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Opaline.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Opaline.Core.Models"
    xmlns:controls="using:Opaline.App.Controls"
    NavigationCacheMode="Enabled">

    <Grid Padding="24,16,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Home" Style="{StaticResource TitleLargeTextBlockStyle}" VerticalAlignment="Center" />
            <Button Content="Refresh"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    HorizontalAlignment="Right"
                    Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="HomeRefreshButton" />
        </Grid>

        <Grid Grid.Row="1">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="48" Height="48"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="HomeLoading" />

            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     Severity="Error" IsClosable="True"
                     VerticalAlignment="Top"
                     AutomationProperties.AutomationId="HomeErrorBar" />

            <GridView
                x:Name="VideoGrid"
                ItemsSource="{x:Bind ViewModel.Videos, Mode=OneWay}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="VideoGrid_ItemClick"
                AutomationProperties.AutomationId="HomeVideoGrid"
                AutomationProperties.Name="Home videos">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:Video">
                        <controls:VideoCard Video="{x:Bind}" Width="320" Margin="0,0,16,16" />
                    </DataTemplate>
                </GridView.ItemTemplate>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>
        </Grid>
    </Grid>
</Page>
