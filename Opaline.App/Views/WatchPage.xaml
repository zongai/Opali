<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Opaline.App.Views.WatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Opaline.Core.Models">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" MinHeight="320" />
            <RowDefinition Height="2*" MinHeight="200" />
        </Grid.RowDefinitions>

        <!-- Player -->
        <Grid Grid.Row="0" Background="#0A0A0A">
            <MediaPlayerElement x:Name="Player"
                                AreTransportControlsEnabled="True"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Stretch="Uniform" />
            <TextBlock x:Name="SubtitleOverlay"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="32,0,32,72"
                       Padding="12,6"
                       MaxWidth="900"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Background="#99000000"
                       IsHitTestVisible="False" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="48" Height="48"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="12" Padding="10,6"
                    Background="#99000000" Foreground="White"
                    BorderThickness="0"
                    Click="Fullscreen_Click"
                    ToolTipService.ToolTip="全屏"
                    AutomationProperties.AutomationId="WatchFullscreen"
                    AutomationProperties.Name="Fullscreen">
                <FontIcon Glyph="&#xE740;" FontSize="16" Foreground="White" />
            </Button>
        </Grid>

        <!-- Meta + comments -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" MinWidth="360" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Padding="20,14,12,20"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.DisplayTitle, Mode=OneWay}"
                               Style="{StaticResource TitleTextBlockStyle}"
                               TextWrapping="WrapWholeWords" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <HyperlinkButton Content="{x:Bind ViewModel.DisplayChannel, Mode=OneWay}"
                                         Click="Channel_Click" Padding="0"
                                         AutomationProperties.AutomationId="WatchChannelLink" />
                        <TextBlock Text="{x:Bind ViewModel.DisplayViews, Mode=OneWay}"
                                   VerticalAlignment="Center" Opacity="0.65"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.StreamKindLabel, Mode=OneWay}"
                                   VerticalAlignment="Center" Opacity="0.45"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>

                    <!-- Actions -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.ToggleLikeCommand}"
                                    AutomationProperties.AutomationId="WatchLike">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8E1;" FontSize="14" />
                                    <TextBlock Text="{x:Bind ViewModel.LikeCount, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.ToggleDislikeCommand}"
                                    AutomationProperties.AutomationId="WatchDislike">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8E0;" FontSize="14" />
                                    <TextBlock Text="{x:Bind ViewModel.DislikeCount, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button Content="订阅"
                                    Command="{x:Bind ViewModel.ToggleSubscribeCommand}"
                                    AutomationProperties.AutomationId="WatchSubscribe" />
                            <Button Content="稍后再看"
                                    Command="{x:Bind ViewModel.AddWatchLaterCommand}"
                                    AutomationProperties.AutomationId="WatchLater" />
                            <Button Content="下载"
                                    Command="{x:Bind ViewModel.DownloadCommand}"
                                    AutomationProperties.AutomationId="WatchDownload" />
                            <Button Content="加入播放列表"
                                    Command="{x:Bind ViewModel.ShowAddToPlaylistCommand}"
                                    AutomationProperties.AutomationId="WatchAddToPlaylist" />
                            <Button Content="不感兴趣"
                                    Command="{x:Bind ViewModel.NotInterestedCommand}"
                                    AutomationProperties.AutomationId="WatchNotInterested" />
                            <Button Content="不推荐频道"
                                    Command="{x:Bind ViewModel.DontRecommendChannelCommand}"
                                    AutomationProperties.AutomationId="WatchDontRecommend" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Quality / captions / translate -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox Header="画质" Width="150"
                                  ItemsSource="{x:Bind ViewModel.Qualities, Mode=OneWay}"
                                  SelectionChanged="Quality_SelectionChanged"
                                  AutomationProperties.AutomationId="WatchQuality">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:StreamInfo">
                                    <TextBlock Text="{x:Bind DisplayLabel}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Header="字幕" Width="160"
                                  x:Name="CaptionCombo"
                                  SelectionChanged="Caption_SelectionChanged"
                                  AutomationProperties.AutomationId="WatchCaptions">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:CaptionTrack">
                                    <TextBlock Text="{x:Bind DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Header="翻译语言" Width="140" x:Name="LangCombo"
                                  SelectionChanged="LangCombo_SelectionChanged"
                                  AutomationProperties.AutomationId="WatchTargetLang">
                            <ComboBoxItem Content="中文（简体）" Tag="zh-CN" IsSelected="True" />
                            <ComboBoxItem Content="中文（繁體）" Tag="zh-TW" />
                            <ComboBoxItem Content="English" Tag="en" />
                            <ComboBoxItem Content="日本語" Tag="ja" />
                            <ComboBoxItem Content="한국어" Tag="ko" />
                            <ComboBoxItem Content="Español" Tag="es" />
                            <ComboBoxItem Content="Français" Tag="fr" />
                            <ComboBoxItem Content="Deutsch" Tag="de" />
                            <ComboBoxItem Content="Русский" Tag="ru" />
                            <ComboBoxItem Content="Tiếng Việt" Tag="vi" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="翻译标题"
                                Command="{x:Bind ViewModel.TranslateTitleCommand}"
                                AutomationProperties.AutomationId="WatchTranslateTitle" />
                        <Button Content="翻译评论"
                                Command="{x:Bind ViewModel.TranslateCommentsCommand}"
                                AutomationProperties.AutomationId="WatchTranslateComments" />
                        <Button Content="翻译字幕"
                                Command="{x:Bind ViewModel.TranslateCaptionCommand}"
                                AutomationProperties.AutomationId="WatchTranslateCaption" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.PlaylistStatus, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" />
                    <ListView x:Name="PlaylistPicker"
                              MaxHeight="160"
                              Visibility="{x:Bind ViewModel.IsPlaylistPickerOpen, Mode=OneWay}"
                              ItemsSource="{x:Bind ViewModel.PendingPlaylistOptions, Mode=OneWay}"
                              IsItemClickEnabled="True"
                              ItemClick="PlaylistPicker_ItemClick"
                              AutomationProperties.AutomationId="WatchPlaylistPicker">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PlaylistAddOption">
                                <TextBlock Text="{x:Bind Title}" Padding="4" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="{x:Bind ViewModel.TranslateStatus, Mode=OneWay}"
                               Opacity="0.75" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.TranslatedTitle, Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextWrapping="WrapWholeWords" />

                    <TextBlock Text="{x:Bind ViewModel.DownloadStatus, Mode=OneWay}"
                               Opacity="0.7" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <ProgressBar Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}"
                                 Maximum="1" Height="4" />

                    <TextBlock Text="{x:Bind ViewModel.CaptionText, Mode=OneWay}"
                               TextWrapping="WrapWholeWords" MaxLines="6" Opacity="0.8"
                               Style="{StaticResource CaptionTextBlockStyle}" />

                    <TextBlock Text="{x:Bind ViewModel.Video.Description, Mode=OneWay, FallbackValue=''}"
                               TextWrapping="WrapWholeWords" MaxLines="8" Opacity="0.7"
                               Style="{StaticResource BodyTextBlockStyle}" />

                    <TextBlock Text="相关视频" Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,8,0,0" />
                    <TextBlock Text="离线：本机已下载"
                               Opacity="0.65"
                               Visibility="{x:Bind ViewModel.ServedOffline, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <ListView ItemsSource="{x:Bind ViewModel.RelatedVideos, Mode=OneWay}"
                              IsItemClickEnabled="True"
                              ItemClick="Related_ItemClick"
                              MaxHeight="260"
                              SelectionMode="None"
                              AutomationProperties.AutomationId="WatchRelated">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Video">
                                <StackPanel Orientation="Horizontal" Spacing="10" Padding="4,6">
                                    <TextBlock Text="{x:Bind Title}" TextWrapping="WrapWholeWords"
                                               Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <InfoBar x:Name="SkipBar" Severity="Informational" IsClosable="True" />
                    <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                             Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                             Severity="Error" IsClosable="True"
                             Title="播放" />
                </StackPanel>
            </ScrollViewer>

            <!-- Comments -->
            <Border Grid.Column="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="16,14,16,16"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="评论" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ProgressRing Grid.Row="1"
                                  IsActive="{x:Bind ViewModel.CommentsLoading, Mode=OneWay}"
                                  Width="28" Height="28"
                                  HorizontalAlignment="Center" VerticalAlignment="Top"
                                  Margin="0,20,0,0" />
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Comments, Mode=OneWay}"
                              SelectionMode="None"
                              AutomationProperties.AutomationId="CommentsList">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CommentThread">
                                <StackPanel Spacing="4" Margin="0,0,0,14">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                                        <Run Text="{x:Bind AuthorName}" />
                                        <Run Text="  " />
                                        <Run Text="{x:Bind PublishedTime}" FontSize="12" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind Text}" TextWrapping="WrapWholeWords"
                                               Style="{StaticResource BodyTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind TranslatedText}" TextWrapping="WrapWholeWords"
                                               Opacity="0.85" Style="{StaticResource BodyTextBlockStyle}" />
                                    <TextBlock Opacity="0.5" Style="{StaticResource CaptionTextBlockStyle}">
                                        <Run Text="👍 " /><Run Text="{x:Bind LikeCount}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
