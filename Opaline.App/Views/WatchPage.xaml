<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Opaline.App.Views.WatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Opaline.Core.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" MinHeight="280" />
            <RowDefinition Height="*" MinHeight="160" />
        </Grid.RowDefinitions>

        <!-- Player -->
        <Grid Grid.Row="0" Background="Black">
            <MediaPlayerElement
                x:Name="Player"
                AreTransportControlsEnabled="True"
                AutoPlay="True"
                Stretch="Uniform"
                AutomationProperties.AutomationId="WatchPlayer"
                AutomationProperties.Name="Video player">
                <MediaPlayerElement.TransportControls>
                    <MediaTransportControls IsFullWindowButtonVisible="True"
                                            IsCompact="False"
                                            IsZoomButtonVisible="False" />
                </MediaPlayerElement.TransportControls>
            </MediaPlayerElement>

            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="56" Height="56"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />

            <Button Content="Fullscreen"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="12" Padding="12,6"
                    Click="Fullscreen_Click"
                    AutomationProperties.AutomationId="WatchFullscreen" />
        </Grid>

        <!-- Meta + comments -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Padding="20,12,12,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.DisplayTitle, Mode=OneWay}"
                               Style="{StaticResource TitleTextBlockStyle}"
                               TextWrapping="WrapWholeWords" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="{x:Bind ViewModel.DisplayChannel, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" Opacity="0.85" />
                        <TextBlock Text="{x:Bind ViewModel.DisplayViews, Mode=OneWay}" Opacity="0.6" />
                        <TextBlock Text="{x:Bind ViewModel.QualityLabel, Mode=OneWay}" Opacity="0.6" />
                        <TextBlock Text="{x:Bind ViewModel.StreamKindLabel, Mode=OneWay}" Opacity="0.5" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Opacity="0.8">
                            <Run Text="👍 " /><Run Text="{x:Bind ViewModel.LikeCount, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Opacity="0.8">
                            <Run Text="👎 " /><Run Text="{x:Bind ViewModel.DislikeCount, Mode=OneWay}" />
                        </TextBlock>
                        <Button Content="Watch Later"
                                Command="{x:Bind ViewModel.AddWatchLaterCommand}"
                                Style="{StaticResource AccentButtonStyle}" Padding="12,4" />
                    </StackPanel>
                    <InfoBar x:Name="SkipBar" IsOpen="False" Severity="Informational"
                             Title="SponsorBlock" IsClosable="True" />
                    <TextBlock Text="{x:Bind ViewModel.DisplayDescription, Mode=OneWay}"
                               TextWrapping="WrapWholeWords" MaxLines="6" Opacity="0.7"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                             Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                             Severity="Error" IsClosable="True" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" Padding="8,12,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Comments" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,8" />
                <ProgressRing Grid.Row="1"
                              IsActive="{x:Bind ViewModel.CommentsLoading, Mode=OneWay}"
                              Width="32" Height="32"
                              HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" />
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Comments, Mode=OneWay}"
                          SelectionMode="None"
                          AutomationProperties.AutomationId="CommentsList">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:CommentThread">
                            <StackPanel Spacing="2" Margin="0,0,0,12" MaxWidth="480">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                                    <Run Text="{x:Bind AuthorName}" />
                                    <Run Text="  " />
                                    <Run Text="{x:Bind PublishedTime}" FontSize="12" />
                                </TextBlock>
                                <TextBlock Text="{x:Bind Text}" TextWrapping="WrapWholeWords"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <TextBlock Opacity="0.55" Style="{StaticResource CaptionTextBlockStyle}">
                                    <Run Text="👍 " /><Run Text="{x:Bind LikeCount}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
