<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Opaline.App.Views.PlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Opaline.Core.Models"
    xmlns:controls="using:Opaline.App.Controls">

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleBlock" Style="{StaticResource TitleLargeTextBlockStyle}" Text="Playlist" />
        <GridView Grid.Row="1" x:Name="VideosGrid"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="Grid_ItemClick">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:Video">
                    <controls:VideoCard Video="{x:Bind}" Width="280" Margin="0,0,12,12" />
                </DataTemplate>
            </GridView.ItemTemplate>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>
    </Grid>
</Page>
